{
  "name": "@sysui/opencode-webui-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode WebUI Monorepo - Frontend application + Node.js server skeleton",
  "type": "module",
  "scripts": {
    "dev": "cd apps/web && yarn dev",
    "dev:server": "cd apps/server && yarn dev",
    "build": "cd apps/web && yarn build && cd ../server && yarn build",
    "build:web": "cd apps/web && yarn build",
    "build:server": "cd apps/server && yarn build",
    "format": "prettier --write .",
    "validate:sc": "tsx apps/web/scripts/validate-success-criteria.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.3",
    "prettier-config-standard": "^7.0.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
