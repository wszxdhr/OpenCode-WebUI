{
  "name": "@sysui/opencode-webui-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode WebUI Monorepo - Frontend application + Node.js server skeleton",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter web build && pnpm --filter server build",
    "build:web": "pnpm --filter web build",
    "build:server": "pnpm --filter server build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "validate:sc": "tsx apps/web/scripts/validate-success-criteria.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.3",
    "prettier-config-standard": "^7.0.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
